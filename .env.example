# Postgres. Production: Neon via Vercel Marketplace (`vercel integration add neon`), then `vercel env pull .env.local --yes`.
# Local: any Postgres, e.g. postgres://localhost:5432/wedding_dev
DATABASE_URL=

# Clerk (Vercel Marketplace: `vercel integration add clerk`). Leave empty locally to use Clerk keyless dev mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=

# Vercel Blob read/write token (created when you connect a Blob store to the project). Needed for photo/music uploads.
BLOB_READ_WRITE_TOKEN=

# Optional. When set, couples get subdomain links: <slug>.<root domain>.
# Local example: localhost:3000   Production example: yourdomain.com
# Leave empty to use path links: <site>/s/<slug>
NEXT_PUBLIC_ROOT_DOMAIN=
